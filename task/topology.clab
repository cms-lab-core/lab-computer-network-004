name: lab-computer-network-004

topology:
  groups:
    hosts:
      kind: linux
      image: ghcr.io/nicolaka/netshoot:v0.16
  nodes:
    pc1:
      group: hosts
      labels:
        flow_icon: pc
      exec:
        - /bin/sh -c "adduser -D -s /bin/sh admin 2>/dev/null || true"
        - /bin/sh -c "echo admin:admin | chpasswd"
        - ssh-keygen -A
        - mkdir -p /run/sshd
        - /bin/sh -c "echo PasswordAuthentication=yes >> /etc/ssh/sshd_config"
        - /usr/sbin/sshd
        - /bin/sh -c "ip link set dev eth1 address 02:00:00:00:04:01"
        - ip link set eth1 up
    sw1:
      group: hosts
      labels:
        flow_icon: switch
      exec:
        - /bin/sh -c "adduser -D -s /bin/sh admin 2>/dev/null || true"
        - /bin/sh -c "echo admin:admin | chpasswd"
        - ssh-keygen -A
        - mkdir -p /run/sshd
        - /bin/sh -c "echo PasswordAuthentication=yes >> /etc/ssh/sshd_config"
        - /usr/sbin/sshd
        - /bin/sh -c "ip link add br0 type bridge 2>/dev/null || true"
        - ip link set eth1 master br0
        - ip link set eth2 master br0
        - ip link set eth3 master br0
        - ip link set eth1 up
        - ip link set eth2 up
        - ip link set eth3 up
        - ip link set br0 up
    pc2:
      group: hosts
      labels:
        flow_icon: pc
      exec:
        - /bin/sh -c "adduser -D -s /bin/sh admin 2>/dev/null || true"
        - /bin/sh -c "echo admin:admin | chpasswd"
        - ssh-keygen -A
        - mkdir -p /run/sshd
        - /bin/sh -c "echo PasswordAuthentication=yes >> /etc/ssh/sshd_config"
        - /usr/sbin/sshd
        - /bin/sh -c "ip link set dev eth1 address 02:00:00:00:04:02"
        - ip link set eth1 up
    pc3:
      group: hosts
      labels:
        flow_icon: pc
      exec:
        - /bin/sh -c "adduser -D -s /bin/sh admin 2>/dev/null || true"
        - /bin/sh -c "echo admin:admin | chpasswd"
        - ssh-keygen -A
        - mkdir -p /run/sshd
        - /bin/sh -c "echo PasswordAuthentication=yes >> /etc/ssh/sshd_config"
        - /usr/sbin/sshd
        - /bin/sh -c "ip link set dev eth1 address 02:00:00:00:04:03"
        - ip link set eth1 up
  links:
    - endpoints: ["pc1:eth1", "sw1:eth1"]
    - endpoints: ["sw1:eth2", "pc2:eth1"]
    - endpoints: ["sw1:eth3", "pc3:eth1"]
